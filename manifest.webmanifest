{
  "id": "./",
  "name": "Voiceoftaade Publications",
  "short_name": "Voiceoftaade",
  "description": "The Voiceoftaade digital publishing and reading app.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#07172b",
